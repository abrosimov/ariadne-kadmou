{
	"name": "ariadne-kadmou",
	"version": "1.0.0",
	"description": "Obsidian companion of kadmos: navigation over kadmos:// references and code anchors.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings 0",
		"test": "node --test --experimental-test-coverage --test-coverage-include=\"src/core/**\" --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=95 \"test/**/*.test.ts\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/e2e",
		"e2e": "npm run build && wdio run ./wdio.conf.mts"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "9.39.4",
		"@types/mocha": "10.0.10",
		"@types/node": "22.19.17",
		"@wdio/cli": "9.32.0",
		"@wdio/globals": "9.31.3",
		"@wdio/local-runner": "9.32.0",
		"@wdio/mocha-framework": "9.32.0",
		"esbuild": "0.25.5",
		"eslint": "9.39.4",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-obsidianmd": "0.4.0",
		"eslint-plugin-unicorn": "65.0.1",
		"globals": "17.6.0",
		"jiti": "2.7.0",
		"mocha": "11.8.0",
		"obsidian": "1.8.7",
		"prettier": "3.9.10",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.2",
		"wdio-obsidian-reporter": "3.3.0",
		"wdio-obsidian-service": "3.3.0",
		"webdriverio": "9.32.0"
	},
	"engines": {
		"node": ">=22.18"
	},
	"dependencies": {
		"ignore": "7.0.12"
	}
}
