# Pinned toolchain versions, with the digests that verify their published
# archives: the single source of truth for bin/bootstrap.sh. pnpm is pinned,
# with its own digest, by `packageManager` in package.json, which Corepack
# enforces.
#
# Flat KEY=value, as in go-core: bootstrap runs before any toolchain exists,
# on a host that needs only bash, curl, tar and sha256sum or shasum. Blank
# lines and # comments are ignored; nothing else is.

NODE_VERSION=v24.21.0
TASK_VERSION=v3.49.1

# SHA256 of the Node.js archive for each supported (os, arch), as the
# publisher states it in https://nodejs.org/dist/<version>/SHASUMS256.txt;
# never taken by hashing a local download.
NODE_SHA256_darwin_arm64=bed7eea5325e1108f32ce5228ddd6a5f0f08a499ee42aa7442aea583702f6057
NODE_SHA256_darwin_amd64=1462cb3b3046b815cf8ea436d3da450ec1a9f11dac7e5a46b0ada5305d7e8097
NODE_SHA256_linux_arm64=724282c3b43aec998aa9527380465b45d229e021b58035f5f4f63095eabfe5d5
NODE_SHA256_linux_amd64=6e1db87ef58b8819e5d5402eff1536491b18edd8eb7bee5ef7897876e88dc5ff

# SHA256 of the official Task release archive, the same pins as go-core.
TASK_SHA256_darwin_arm64=0f556b66df69d53b790c7fd26bfab73543b4a5ce1767df6b2e8499619e2a205b
TASK_SHA256_darwin_amd64=8bc4dd3baed1c71956ade0bb0a9c1b94e3ed7b65e7f2ff3aab13d0562c820e59
TASK_SHA256_linux_arm64=aa6732c9c66397c5380ec2b60c070fd599075b2a8538dba03f3a21edc99ab0cb
TASK_SHA256_linux_amd64=4e7d24f1bf38218aec8f244eb7ba671f898830f9f87b3c9b30ff1c09e3135576
