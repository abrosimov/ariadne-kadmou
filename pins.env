# Pinned toolchain versions, with the digests that verify their published
# archives: the single source of truth for bin/bootstrap.sh. pnpm is pinned,
# with its own digest, by `packageManager` in package.json, which Corepack
# enforces.
#
# Renovate moves the versions; `task pins` then names every digest that no
# longer matches what the publisher states, and CI runs it. Filling the
# digests is deliberately manual, as in go-core.
#
# Flat KEY=value, as in go-core: bootstrap runs before any toolchain exists,
# on a host that needs only bash, curl, tar and sha256sum or shasum. Blank
# lines and # comments are ignored; nothing else is.

NODE_VERSION=v24.22.0
TASK_VERSION=v3.54.0

# SHA256 of the Node.js archive for each supported (os, arch), as the
# publisher states it in https://nodejs.org/dist/<version>/SHASUMS256.txt;
# never taken by hashing a local download.
NODE_SHA256_darwin_arm64=6a9724d9b50a5f22b4816cded441b5a8d9ddae546191a5e5b7efa5a5e2ee26d5
NODE_SHA256_darwin_amd64=495e3f273c645f3c4677d438304cdfc701729ea5dec5728f5c8e76a2dece4b91
NODE_SHA256_linux_arm64=b7e7991d5407815adfa74a2a9cd4db683552c8ce32ff4a295c22e972849c3f5d
NODE_SHA256_linux_amd64=28ea0a438de9a13bd7891fd758eee6c7819ee8af5442dfd8d45bd65e56d4228c

# SHA256 of the official Task release archive, as task_checksums.txt in the
# release states it.
TASK_SHA256_darwin_arm64=12a69fcf37bb8d5bc9150c44f9a936775b73e59ff044c2c245232f198c135637
TASK_SHA256_darwin_amd64=0543b0844a725814c0412d3f4bed12873ce9ed0da207b15775f63a97d734aac0
TASK_SHA256_linux_arm64=d7189d439d4a6058e39e1b2acd7c8b27acd4856691b408f23b242e4294e1df5b
TASK_SHA256_linux_amd64=680859dbb4d881a9c72d4d9a8f510825450849af8567deacd7302c01124416fb
