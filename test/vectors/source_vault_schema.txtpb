# Vendored from abrosimov/kadmos@aecf172802282bc79cdefddfce84a9ea3527afc5 .vault-schema.txtpb, the source vault's
# root schema, which declares config.code_anchors. Refresh with the vectors.

# .vault-schema.txtpb -- the GLOBAL half of the Kadmos source vault schema,
# authored as textproto (cadmus.v1.VaultSchema, see proto/cadmus/v1/schema.proto).
#
# The framework-generic meta-schema (message shape) is shared with the Praetor
# vault pattern on purpose; the vocabulary below is Kadmos-own. This file holds
# what is global: version, config, the universal skeleton, and the cross-cutting
# subtypes that are not bound to a single folder (moc, term, rule). Folder-bound
# subtypes declare themselves in <dir>/.vault-schema.txtpb.
version: 1

config {
  naming_convention {
    zero_pad_width: 3
    separator: "-"
  }
  validation_scope {
    excluded_root_directory: ".agents"
    excluded_root_directory: ".obsidian"
    excluded_root_directory: "artifacts"
    excluded_root_directory: "templates"
    excluded_file_name: "AGENTS.md"
    excluded_file_name: "CLAUDE.md"
    excluded_file_name: "PROJECT_AGENTS.md"
    excluded_file_name: "README.md"
  }
  retention_projection {
    state: "active"
  }
  retention_projection {
    state: "archived"
    root_directory: "archive"
  }
  retention_projection {
    state: "buried"
    root_directory: "graveyard"
  }
  # Code anchors (D-038, standards/code-anchors.md). The marker names the
  # Obsidian companion of kadmos and is part of this contract.
  code_anchors {
    marker: "ariadne-kadmou"
    slug_pattern: "^[a-z0-9]+(-[a-z0-9]+)*$"
    relation: "implements"
    relation: "tests"
    relation: "evidences"
    reverse_field: "anchored_by"
  }
  # Closed tag vocabulary. Empty for now -- tags are not used in the meta layer
  # yet; seed entries here when they are.
}

# --- Universal skeleton: every note carries these ---------------------------

skeleton {
  name: "type"
  required: REQUIRED
  kind: STRING
}
skeleton {
  name: "subtype"
  required: REQUIRED
  # The assembled type{} declarations are the one vocabulary authority. A
  # descendant extends that vocabulary with its own delta; a closed skeleton
  # enum would force it to redefine this Kadmos-owned root file.
  kind: STRING
}
skeleton {
  name: "note_id"
  required: REQUIRED
  kind: STRING
  pattern: "^[0-9]{14}([0-9]{3})?$"
}
skeleton {
  name: "created"
  required: REQUIRED
  kind: DATE
}
skeleton {
  name: "language"
  required: REQUIRED
  kind: ENUM
  enum: "ru"
  enum: "en"
}
skeleton {
  name: "gov_self_evolvement"
  required: REQUIRED
  kind: BOOL
}
skeleton {
  name: "retention"
  required: REQUIRED
  kind: ENUM
  enum: "active"
  enum: "archived"
  enum: "buried"
}
skeleton {
  name: "aliases"
  required: REQUIRED_IF_TYPED
  kind: STRING_LIST
}
skeleton {
  name: "tags"
  required: OPTIONAL
  kind: STRING_LIST
}
# The reverse end of a code anchor (D-038): slugs of this repository's anchors
# whose reference names the note. Optional on every note; exact when present.
skeleton {
  name: "anchored_by"
  required: OPTIONAL
  kind: STRING_LIST
}

# --- Cross-cutting subtypes (not folder-bound) ------------------------------

# A Map of Content. Lives in several folders (state/, interaction/, roadmaps/,
# decisions/), so it is declared here rather than in one folder file.
type {
  subtype: "moc"
  typed: false
  field {
    name: "roadmap_name"
    required: OPTIONAL
    kind: STRING
  }
}

# A normative rule note. Cross-cutting: lives in interaction/ (protocol rules) and
# standards/ (form standards instances inherit -- dissolve-specs). Moved here from
# interaction/.vault-schema.txtpb when standards/ was created: a subtype declared in
# two folder files is a load error, and validation scopes subtypes vault-wide anyway.
# Lifecycle (dissolve-specs, owner 2026-07-22): body is immutable once landed on
# master; a content change is a supersession -- the old note's frontmatter gets
# status: superseded + superseded_by, the successor carries the reason.
type {
  subtype: "rule"
  typed: false
  field {
    name: "status"
    required: REQUIRED
    kind: ENUM
    enum: "draft"
    enum: "active"
    enum: "superseded"
  }
  field {
    name: "superseded_by"
    required: OPTIONAL
    kind: WIKILINK
  }
  conditional_field {
    when_field: "status"
    when_value: "superseded"
    required_field: "superseded_by"
  }
  conditional_field {
    when_field: "status"
    when_value: "active"
    forbidden_field: "superseded_by"
  }
}

# A vocabulary term. Not yet materialised (vocabulary/ pending adopt-vocabulary-directory);
# declared forward so the first term note validates without a schema edit.
type {
  subtype: "term"
  typed: true
  id_prefix: "TERM"
  field {
    name: "bounded_context"
    required: REQUIRED
    kind: STRING
  }
}

# Shared agent artifacts are cross-cutting; the adopting project owns their
# placement while Kadmos owns their frontmatter contract.
type {
  subtype: "agent-artifact"
  typed: false
  field {
    name: "note_role"
    required: REQUIRED
    kind: ENUM
    enum: "artifact"
  }
  field {
    name: "artifact_kind"
    required: REQUIRED
    kind: ENUM
    enum: "research"
    enum: "proposal"
    enum: "review"
    enum: "retrospective"
  }
  field {
    name: "publication_status"
    required: REQUIRED
    kind: ENUM
    enum: "draft"
    enum: "published"
  }
  field {
    name: "published_at"
    required: OPTIONAL
    kind: DATE
  }
  field {
    name: "status"
    required: REQUIRED
    kind: ENUM
    enum: "active"
    enum: "superseded"
  }
  field {
    name: "superseded_by"
    required: OPTIONAL
    kind: WIKILINK
  }
  field {
    name: "authorship"
    required: REQUIRED
    kind: ENUM
    enum: "agent"
  }
  field {
    name: "assistant"
    required: REQUIRED
    kind: STRING
  }
  field {
    name: "source_refs"
    required: OPTIONAL
    kind: WIKILINK_LIST
  }
  field {
    name: "related"
    required: OPTIONAL
    kind: WIKILINK_LIST
  }
  field {
    name: "evolved_from"
    required: OPTIONAL
    kind: WIKILINK
  }
  conditional_field {
    when_field: "publication_status"
    when_value: "published"
    required_field: "published_at"
  }
  conditional_field {
    when_field: "publication_status"
    when_value: "draft"
    forbidden_field: "published_at"
  }
  conditional_field {
    when_field: "status"
    when_value: "superseded"
    required_field: "superseded_by"
  }
  conditional_field {
    when_field: "status"
    when_value: "active"
    forbidden_field: "superseded_by"
  }
}

# Katoptron is path-bound when cases exist, but its folder is optional. Keeping
# the active subtype global lets an empty distributed vault omit katoptron/.
type {
  subtype: "katoptron-behaviour-case"
  typed: false
  field {
    name: "note_role"
    required: REQUIRED
    kind: ENUM
    enum: "artifact"
  }
  field {
    name: "artifact_kind"
    required: REQUIRED
    kind: ENUM
    enum: "retrospective"
  }
  field {
    name: "publication_status"
    required: REQUIRED
    kind: ENUM
    enum: "published"
  }
  field {
    name: "published_at"
    required: REQUIRED
    kind: DATE
  }
  field {
    name: "status"
    required: REQUIRED
    kind: ENUM
    enum: "active"
    enum: "superseded"
  }
  field {
    name: "superseded_by"
    required: OPTIONAL
    kind: WIKILINK
  }
  field {
    name: "authorship"
    required: REQUIRED
    kind: ENUM
    enum: "agent"
  }
  field {
    name: "assistant"
    required: REQUIRED
    kind: STRING
  }
  field {
    name: "session_id"
    required: REQUIRED
    kind: STRING
  }
  field {
    name: "model_provider"
    required: OPTIONAL
    kind: STRING
  }
  field {
    name: "model"
    required: OPTIONAL
    kind: STRING
  }
  field {
    name: "reasoning_effort"
    required: OPTIONAL
    kind: STRING
  }
  field {
    name: "interface"
    required: OPTIONAL
    kind: STRING
  }
  field {
    name: "cli_version"
    required: OPTIONAL
    kind: STRING
  }
  field {
    name: "session_started_at"
    required: OPTIONAL
    kind: STRING
  }
  field {
    name: "source_refs"
    required: OPTIONAL
    kind: WIKILINK_LIST
  }
  field {
    name: "related"
    required: OPTIONAL
    kind: WIKILINK_LIST
  }
  field {
    name: "evolved_from"
    required: OPTIONAL
    kind: WIKILINK
  }
  conditional_field {
    when_field: "status"
    when_value: "superseded"
    required_field: "superseded_by"
  }
  conditional_field {
    when_field: "status"
    when_value: "active"
    forbidden_field: "superseded_by"
  }
}
